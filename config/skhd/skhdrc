
# External keyboards: swap left_cmd <-> left_ctrl (Windows key layout)
.device kbd1 { vendor: 0x258A, product: 0x013B }
.remap lcmd [device kbd1] : lctrl
.remap lctrl [device kbd1] : lcmd

# App Shortcuts

cmd - return : open -na Ghostty
cmd - e : zed -n
f4 : open -a Raycast
f5 : open -a Screenshot

# Toggle sketchybar to reveal the native macOS menu bar
cmd + shift - m : sketchybar --bar hidden=toggle
